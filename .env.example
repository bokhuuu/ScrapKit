APP_NAME=ScrapKit
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=scrapkit
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
SCRAPER_MAIL_TO=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# Scraper - General
# =============================================================================
SCRAPER_REQUEST_DELAY=2
SCRAPER_DELAY_JITTER=0.3
SCRAPER_BROWSER_LANGUAGES=en-US,en
SCRAPER_MAX_PAGES=50

# =============================================================================
# Scraper - Browser
# =============================================================================
CHROMEDRIVER_URL=http://localhost:9515
BROWSER_CONNECT_TIMEOUT_MS=60000
BROWSER_REQUEST_TIMEOUT_MS=60000
ELEMENT_WAIT_TIMEOUT_S=10
BROWSER_WINDOW_SIZE=1920,1080
BROWSER_POOL_SIZE=1
SCRAPER_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"

# =============================================================================
# Scraper - Retry
# =============================================================================
SCRAPER_RETRY_ATTEMPTS=3
SCRAPER_RETRY_DELAY_MS=1000
SCRAPER_RETRY_BASE_DELAY=30

# =============================================================================
# Scraper - Queue
# =============================================================================
SCRAPER_CONCURRENCY=3
SCRAPER_RETRY_TIMES=3
SCRAPER_TIMEOUT_S=60
SCRAPER_RATE_LIMIT_WINDOW=1
SCRAPER_RATE_LIMIT_RELEASE=5

SCRAPER_BATCH_NAME_PATTERN="{source}-run-{id}"

# =============================================================================
# Profile - list.am
# =============================================================================
LISTAM_REQUEST_DELAY=3
LISTAM_MAX_PAGES=50
LISTAM_EMAIL=
LISTAM_PASSWORD=

# =============================================================================
# Notifications - Telegram, Mail
# =============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SCRAPER_EXPORT_PATH=exports

# =============================================================================
# Scraper - Proxy
# =============================================================================
SCRAPER_PROXY_ENABLED=false
SCRAPER_PROXY_STRATEGY=round_robin
SCRAPER_PROXIES=
SCRAPER_PROXY_USERNAME=
SCRAPER_PROXY_PASSWORD=

# =============================================================================
# API Rate Limiting
# =============================================================================
API_RATE_LIMIT=60
API_PER_TOKEN_LIMIT=30

# =============================================================================
# Drift Detection
# =============================================================================
SCRAPER_DRIFT_MIN_LISTINGS=10
SCRAPER_DRIFT_MAX_NULL_RATE=0.5

# =============================================================================
# Sentry - Error Tracking
# =============================================================================
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=local